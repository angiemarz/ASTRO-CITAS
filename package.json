{
  "name": "astrobloomx-agenda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AstroBloomx Agenda — agenda personal de citas (PWA + Cloudflare Workers + D1)",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply astrobloomx-agenda --local",
    "db:migrate:remote": "wrangler d1 migrations apply astrobloomx-agenda --remote",
    "deploy": "npm run build && wrangler d1 migrations apply astrobloomx-agenda --remote && wrangler deploy",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  }
}
